{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "ask",
    "websearch": "ask",
    "external_directory": "deny",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cargo metadata*": "allow",
      "cargo fmt*": "allow",
      "cargo check*": "allow",
      "cargo clippy*": "allow",
      "cargo test*": "allow",
      "cargo nextest*": "allow",
      "cargo build*": "allow",
      "git push*": "deny",
      "gh pr merge*": "deny",
      "gh release create*": "deny"
    }
  }
}
