# See infra/README.md for local Compose setup and private generated secrets.
# Set LOCAL_UID, LOCAL_GID and KUNVENO_LOCAL_DIR in your shell before starting.
# Compose does not require PostgreSQL or RabbitMQ.
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Optional coding-agent provider credentials.
# Keep real values out of Git.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
BAILIAN_CODING_PLAN_API_KEY=
MOONSHOT_API_KEY=
