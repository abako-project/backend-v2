# See infra/README.md for local Compose setup and private generated secrets.
# Set LOCAL_UID, LOCAL_GID and KUNVENO_LOCAL_DIR in your shell before starting.
# Compose starts PostgreSQL for adapter-owned data; RabbitMQ is not required.
# Development defaults are local-only. Set both values for another database/password.
# ADAPTER_POSTGRES_PASSWORD=choose-a-local-password
# ADAPTER_DATABASE_URL=postgres://kunveno:choose-a-local-password@postgres:5432/kunveno_adapter
ALLOWED_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Optional coding-agent provider credentials.
# Keep real values out of Git.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
BAILIAN_CODING_PLAN_API_KEY=
MOONSHOT_API_KEY=
